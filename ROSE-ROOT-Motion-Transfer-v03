import maya.cmds as cmds

WINDOW_NAME = "ROSERootMotionUI"

# ------------------------------------------------
# UI
# ------------------------------------------------
def create_ui():
    if cmds.window(WINDOW_NAME, exists=True):
        cmds.deleteUI(WINDOW_NAME)

    cmds.window(
        WINDOW_NAME,
        title="ROSE Root Motion (Maya 2026)",
        widthHeight=(360, 420)
    )
    cmds.columnLayout(adjustableColumn=True, rowSpacing=10)

    cmds.text(label="Select Pelvis / Master Control")
    cmds.rowLayout(nc=2, cw2=(250, 90))
    cmds.textField("controlField")
    cmds.button(label="Select", command=select_control)
    cmds.setParent("..")

    cmds.text(label="Select Root Joint")
    cmds.rowLayout(nc=2, cw2=(250, 90))
    cmds.textField("rootField")
    cmds.button(label="Select", command=select_root)
    cmds.setParent("..")

    cmds.separator(height=10)

    # ---------------- TRANSLATE ----------------
    cmds.checkBox("translateCheck", label="Translate Enabled", value=True,
                  changeCommand=toggle_translate_ui)
    cmds.rowLayout("translateAxisRow", nc=3, cw3=(110, 110, 110))
    cmds.checkBox("txCheck", label="X", value=True)
    cmds.checkBox("tyCheck", label="Y", value=False)
    cmds.checkBox("tzCheck", label="Z", value=True)
    cmds.setParent("..")

    cmds.separator(height=10)

    # ---------------- ROTATE ----------------
    cmds.checkBox("rotateCheck", label="Rotate Enabled (Pelvis Y rotation)",
                  value=True, changeCommand=toggle_rotate_ui)
    cmds.radioButtonGrp(
        "axisSwitch",
        label="Root Rotate Axis: ",
        numberOfRadioButtons=2,
        labelArray2=["Y Axis", "Z Axis"],
        columnWidth3=(120, 70, 70),
        select=2
    )

    cmds.separator(height=10)

    cmds.checkBox(
        "zeroRootCheck",
        label="Start root at 0,0,0",
        value=True
    )

    cmds.separator(height=15)

    cmds.button(
        label="START - Root Motion Transfer",
        height=45,
        bgc=(0.25, 0.65, 0.25),
        command=transfer_root_motion
    )

    cmds.showWindow(WINDOW_NAME)


def toggle_translate_ui(*args):
    state = cmds.checkBox("translateCheck", q=True, value=True)
    cmds.rowLayout("translateAxisRow", e=True, enable=state)


def toggle_rotate_ui(*args):
    state = cmds.checkBox("rotateCheck", q=True, value=True)
    cmds.radioButtonGrp("axisSwitch", e=True, enable=state)


# ------------------------------------------------
# Selection Helpers
# ------------------------------------------------
def select_control(*args):
    sel = cmds.ls(sl=True)
    if sel:
        cmds.textField("controlField", e=True, text=sel[0])


def select_root(*args):
    sel = cmds.ls(sl=True)
    if sel:
        cmds.textField("rootField", e=True, text=sel[0])


# ------------------------------------------------
# World Space Helpers
# ------------------------------------------------
def get_world_pos(obj):
    return cmds.xform(obj, q=True, ws=True, t=True)


def get_world_rot_y(obj):
    """Pelvis WORLD Y rotation"""
    return cmds.xform(obj, q=True, ws=True, ro=True)[1]


# ------------------------------------------------
# Root Motion Transfer
# ------------------------------------------------
def transfer_root_motion(*args):
    control = cmds.textField("controlField", q=True, text=True)
    root = cmds.textField("rootField", q=True, text=True)

    if not control or not root or not cmds.objExists(control) or not cmds.objExists(root):
        cmds.warning("Control or Root is not valid!")
        return

    do_translate = cmds.checkBox("translateCheck", q=True, value=True)
    do_rotate = cmds.checkBox("rotateCheck", q=True, value=True)
    zero_root = cmds.checkBox("zeroRootCheck", q=True, value=True)

    use_x = cmds.checkBox("txCheck", q=True, value=True)
    use_y = cmds.checkBox("tyCheck", q=True, value=True)
    use_z = cmds.checkBox("tzCheck", q=True, value=True)

    # 1 = Y Axis, 2 = Z Axis
    rot_attr = "rotateY" if cmds.radioButtonGrp("axisSwitch", q=True, select=True) == 1 else "rotateZ"

    start = int(cmds.playbackOptions(q=True, min=True))
    end = int(cmds.playbackOptions(q=True, max=True))
    original_time = cmds.currentTime(q=True)

    cmds.cutKey(root, t=(start, end), clear=True)
    cmds.currentTime(start)

    # Reference values
    base_pos = get_world_pos(control)
    base_rot_y = get_world_rot_y(control)

    for frame in range(start, end + 1):
        cmds.currentTime(frame)

        pos = get_world_pos(control)
        rot_y = get_world_rot_y(control)

        if zero_root:
            tx = pos[0] - base_pos[0]
            ty = pos[1] - base_pos[1]
            tz = pos[2] - base_pos[2]
            rot_val = rot_y - base_rot_y
        else:
            tx, ty, tz = pos[0], pos[1], pos[2]
            rot_val = rot_y

        if do_translate:
            if use_x:
                cmds.setKeyframe(root, at="translateX", v=tx, t=frame)
            if use_y:
                cmds.setKeyframe(root, at="translateY", v=ty, t=frame)
            if use_z:
                cmds.setKeyframe(root, at="translateZ", v=tz, t=frame)

        if do_rotate:
            cmds.setKeyframe(root, at=rot_attr, v=rot_val, t=frame)

    cmds.currentTime(original_time)

    cmds.confirmDialog(
        title="Done",
        message="Root motion transfer completed.",
        button=["OK"]
    )


# ------------------------------------------------
# Run
# ------------------------------------------------
create_ui()
